# Akamana Environment Configuration
# Copy to .env and customize values

# =============================================================================
# SERVER
# =============================================================================
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info,sqlx=warn
# Product name shown in the browser tab, the top bar and the sign-in screen.
# APP_TITLE=Akamana

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=mysql://akamana:akamana_password@mariadb:3306/akamana

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
AUTH_MODE=local

# JWT (local auth only)
JWT_SECRET=change-this-long-random-secret-min-32-chars
JWT_EXP_MINUTES=30

# OIDC (when AUTH_MODE=oidc)
# OIDC_ISSUER=https://your-idp.example.com
# OIDC_AUDIENCE=akamana
# OIDC_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
# OIDC_ROLE_CLAIM=roles
#   ^ Claim path in ID token for Akamana role (e.g. "roles", "groups", "realm_access/roles")
#   ^ Map groups via dot notation: "realm_access.roles" or "groups"

# MFA enforcement (default: false).
# When true, a local account with no second factor cannot complete a sign-in:
# it is handed a short-lived enrollment token and must set up TOTP first.
# Accounts that already have TOTP are always challenged regardless of this flag.
# REQUIRE_MFA=true

# Passkeys / WebAuthn (optional, off unless BOTH are set).
# WEBAUTHN_RP_ID must be the exact site domain (no scheme, no port) and
# WEBAUTHN_ORIGIN the origin the browser sees. WebAuthn only works over HTTPS
# (or http://localhost), so leave these unset on a plain-HTTP deployment.
# Examples:
#   WEBAUTHN_RP_ID=akamana.example.com
#   WEBAUTHN_ORIGIN=https://akamana.example.com
# WEBAUTHN_RP_ID=
# WEBAUTHN_ORIGIN=

# =============================================================================
# KEY MANAGEMENT
# =============================================================================
KEY_ENCRYPTION_KEY_B64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ROOT_COMMON_NAME=Akamana Root CA
ROOT_VALID_YEARS=10

# Optional: path to custom crypto options JSON (allowed ciphers / key lengths).
# Default when unset: /data/crypto_options.json — template: deploy/crypto_options.json.example
# AKAMANA_CRYPTO_OPTIONS_PATH=/data/crypto_options.json

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins. DO NOT use "*" in production.
# Examples:
#   ALLOWED_ORIGINS=http://localhost:3000
#   ALLOWED_ORIGINS=https://akamana.example.com
#   ALLOWED_ORIGINS=https://app1.example.com,https://app2.example.com
ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# PROXY / LOAD BALANCER
# =============================================================================
# Comma-separated IP addresses of trusted reverse proxies.
# The x-forwarded-for header will only be trusted from these IPs.
# Leave empty to always use direct client IP (recommended if no proxy).
# Examples:
#   TRUSTED_PROXY_IPS=10.0.0.1
#   TRUSTED_PROXY_IPS=10.0.0.1,10.0.0.2
# TRUSTED_PROXY_IPS=

# =============================================================================
# SMTP / EMAIL ALERTS
# =============================================================================
# Also powers self-service password reset: the "Forgot password?" link on the
# sign-in screen is only offered when SMTP_HOST and SMTP_FROM are both set.
# Without SMTP, an admin can still issue a one-time reset link from the Users
# page. The reset link is built from the "Public base URL" setting (Settings
# page) — set it, or the mail can only tell the user the token.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=akamana@example.com
SMTP_USERNAME=
SMTP_PASSWORD=

# =============================================================================
# SIEM / WEBHOOKS
# =============================================================================
# SIEM_WEBHOOK_URL=https://your-siem.example.com/api/events

# =============================================================================
# BOOTSTRAP ADMIN
# =============================================================================
# REQUIRED: Must be at least 15 characters. Cannot be "ChangeMeNow!" or "admin".
# IMPORTANT: Change this before first deployment!
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=YourSecurePasswordHere123!

# =============================================================================
# DATA & ADDONS
# =============================================================================
AKAMANA_DATA_DIR=/data
ADDONS_DIR=/data/addons
